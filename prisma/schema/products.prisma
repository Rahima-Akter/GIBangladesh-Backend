model Product {
  id String @id @default(uuid())

  title       String
  description String

  coverImage String
  origin     String

  culturalSignificancehistory String
  detaildDescription          String

  category             String
  giRegistrationNumber String
  registeredYear       Int
  isVerified           Boolean @default(true)

  status ProductStatus @default(ACTIVE)

  craftingSteps String[]
  tags          String[]

  views Int @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  likes    ProductLike[]
  dislikes ProductDislike[]
  flags    ProductFlag[]
}

model ProductLike {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("product_likes")
}

model ProductDislike {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("product_dislikes")
}

model ProductFlag {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("product_flags")
}
